#include <cs50.h>
#include <stdio.h>

float average(int length, int array[]);

int main(void)
{
    // Get the number of scores to define the size dynamically
    int N = get_int("How many scores? ");

    int scores[N];
    for (int i = 0; i < N; i++)
    {
        // Using (i + 1) to show human count
        scores[i] = get_int("Score %i: ", i + 1);
    }

    // 2 decimals for better readability
    printf("Average: %.2f\n", average(N, scores));
}

// Doing calculations on a separate function for more readibality
float average(int length, int array[])
{
    int sum = 0;
    for (int i = 0; i < length; i++)
    {
        sum += array[i];
    }
    // Casting for keeping it decimal
    return sum / (float) length;
}
