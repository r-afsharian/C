#include <cs50.h>
#include <stdio.h>

void print_future(int n);

int main(void)
{
    while (true)
    {

        int n = get_int("Enter a number (1-10): ");

        if (n < 1 || n > 10)
        {
            printf("Please enter an option between 1 and 10.\n");
            continue;
        }

        print_future(n);
    }
}

void print_future(int n)
{

    for (int i = 0; i < n; i++)
    {
        printf("Future\n");
    }

}
